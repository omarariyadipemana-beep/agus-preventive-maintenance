# ==============================================================
# KONFIGURASI DOCKER ENVIRONMENT - UBUNTU 26.04 LTS
# Salin file ini menjadi .env sebelum menjalankan docker compose:
#   cp .env.docker.example .env
# ==============================================================

# Port akses pada server Ubuntu (default: 3001)
# Contoh jika ingin dibuka langsung di port web standar: APP_PORT=80
APP_PORT=3001

# Kunci rahasia token PIN (Ganti dengan teks acak yang aman untuk server produksi)
AUTH_SECRET=rahasia-super-aman-agus-pm-2026-salt

# Batasan domain CORS yang diizinkan (gunakan * untuk mengizinkan akses dari semua IP/Domain LAN)
ALLOWED_ORIGINS=*

